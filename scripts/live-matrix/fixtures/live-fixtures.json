{
 "setup": {
  "assert": {
   "ready": true
  },
  "steps": [
   {
    "id": "stop-profiler",
    "argv": [
     "tools",
     "run",
     "profiler.stop",
     "--input",
     "{}"
    ],
    "expect": {
     "equals": {
      "data.profiler.enabled": false,
      "data.profiler.profileEditor": false
     }
    }
   },
   {
    "id": "load-baseline-scene",
    "argv": [
     "tools",
     "run",
     "scene.load",
     "--input",
     "{\"path\":\"Assets/UnityCLIValidation/MatrixScene.unity\"}"
    ],
    "expect": {
     "equals": {
      "data.scene.path": "Assets/UnityCLIValidation/MatrixScene.unity",
      "data.scene.isLoaded": true
     }
    }
   },
   {
    "id": "read-proof-before",
    "argv": [
     "tools",
     "run",
     "scene.gameobject",
     "--input",
     "{\"target\":\"Main Camera\",\"includeComponents\":false}"
    ],
    "expect": {
     "exists": [
      "data.gameObject.transform.position.x"
     ]
    },
    "capture": {
     "proofBefore": "data.gameObject.transform.position.x"
    }
   },
   {
    "id": "seed-dev-project",
    "argv": [
     "tools",
     "run",
     "code.execute",
     "--input",
     "{\"file\":\"scripts/live-matrix/fixtures/live-matrix-setup.cs\",\"completionProbe\":{\"readTool\":\"scene.gameobject\",\"input\":{\"target\":\"Main Camera\",\"includeComponents\":false},\"assertions\":[{\"path\":\"/gameObject/transform/position/x\",\"operator\":\"approx\",\"before\":${proofBefore},\"after\":31337,\"tolerance\":0.001}]}}"
    ],
    "expect": {
     "equals": {
      "data.completion.assertions.0.value": 31337
     },
     "exists": [
      "data.compile.diagnostics",
      "data.runtime.returnValue"
     ]
    }
   },
   {
    "id": "restore-proof",
    "argv": [
     "tools",
     "run",
     "game-object.modify",
     "--input",
     "{\"target\":\"Main Camera\",\"x\":0,\"y\":0,\"z\":0}"
    ],
    "expect": {
     "equals": {
      "data.gameObject.transform.position.x": 0
     }
    }
   },
   {
    "id": "save-baseline-scene",
    "argv": [
     "tools",
     "run",
     "scene.save",
     "--input",
     "{}"
    ],
    "expect": {}
   },
   {
    "id": "seed-vfx-graph",
    "argv": [
     "tools",
     "run",
     "vfx.graph.create",
     "--input",
     "{\"path\":\"Assets/VFX/Explosion.vfx\",\"overwrite\":true}"
    ],
    "expect": {
     "exists": [
      "data.graph"
     ]
    }
   },
   {
    "id": "ready",
    "argv": [
     "tools",
     "run",
     "editor.state",
     "--input",
     "{}"
    ],
    "expect": {
     "equals": {
      "data.status": "ready",
      "data.state.playMode.known": true,
      "data.state.playMode.value": "edit"
     }
    }
   }
  ]
 },
