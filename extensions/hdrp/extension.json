{
  "id": "hdrp",
  "name": "High Definition Render Pipeline",
  "version": "1.0.0",
  "description": "HDRP rendering tools: volume components and High Definition Render Pipeline asset settings.",
  "unityPackages": [
    {
      "packageId": "com.unity.render-pipelines.high-definition",
      "displayName": "High Definition Render Pipeline"
    }
  ],
  "contributions": {
    "tools": [
      {
        "name": "hdrp.volume"
      },
      {
        "name": "hdrp.settings"
      }
    ],
    "contexts": [],
    "csharpEntries": [
      {
        "type": "UnityCli.HDRP.HdrpVolumeTools",
        "description": "Bridge handlers for HDRP volume operations."
      },
      {
        "type": "UnityCli.HDRP.HdrpSettingsTools",
        "description": "Bridge handlers for HDRP pipeline settings operations."
      }
    ]
  },
  "unityInstall": {
    "layout": "directory",
    "include": [
      "extension.json",
      "unitypkg/",
      "docs/"
    ]
  }
}
