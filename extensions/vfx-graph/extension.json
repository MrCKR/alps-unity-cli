{
  "id": "vfx-graph",
  "name": "VFX Graph",
  "version": "1.0.0",
  "description": "Visual effects extension with VFX Graph package tools plus built-in ParticleSystem, LineRenderer, and TrailRenderer tools.",
  "unityPackages": [],
  "contributions": {
    "tools": [
      {
        "name": "vfx.graph",
        "requiresPackages": [
          "com.unity.visualeffectgraph"
        ]
      },
      {
        "name": "vfx.effect",
        "requiresPackages": [
          "com.unity.visualeffectgraph"
        ]
      },
      {
        "name": "vfx.parameter",
        "requiresPackages": [
          "com.unity.visualeffectgraph"
        ]
      },
      {
        "name": "vfx.control",
        "requiresPackages": [
          "com.unity.visualeffectgraph"
        ]
      },
      {
        "name": "vfx.event",
        "requiresPackages": [
          "com.unity.visualeffectgraph"
        ]
      },
      {
        "name": "vfx.template",
        "requiresPackages": [
          "com.unity.visualeffectgraph"
        ]
      },
      {
        "name": "vfx.particle-create",
        "requiresPackages": []
      },
      {
        "name": "vfx.particle-info",
        "requiresPackages": []
      },
      {
        "name": "vfx.particle-main",
        "requiresPackages": []
      },
      {
        "name": "vfx.particle-emission",
        "requiresPackages": []
      },
      {
        "name": "vfx.particle-shape",
        "requiresPackages": []
      },
      {
        "name": "vfx.particle-play",
        "requiresPackages": []
      },
      {
        "name": "vfx.particle-module",
        "requiresPackages": []
      },
      {
        "name": "vfx.line-create",
        "requiresPackages": []
      },
      {
        "name": "vfx.line-positions",
        "requiresPackages": []
      },
      {
        "name": "vfx.trail",
        "requiresPackages": []
      }
    ],
    "contexts": [],
    "csharpEntries": [
      {
        "type": "UnityCli.VfxCommands",
        "description": "Bridge handler for VFX Graph, ParticleSystem, LineRenderer, and TrailRenderer operations."
      }
    ]
  },
  "unityInstall": {
    "layout": "directory",
    "include": [
      "extension.json",
      "unitypkg/",
      "docs/"
    ]
  }
}
