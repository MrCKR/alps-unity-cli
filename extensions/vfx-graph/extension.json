{
  "id": "vfx-graph",
  "name": "vfx-graph",
  "title": "VFX Graph",
  "version": "1.0.0",
  "description": "Visual effects extension for VFX Graph plus Unity built-in ParticleSystem, LineRenderer, and TrailRenderer tools.",
  "packageName": "unity-cli-extension-vfx-graph",
  "requiresUnityPackages": [],
  "unityPackages": [],
  "providesTools": [
    "vfx.graph",
    "vfx.effect",
    "vfx.parameter",
    "vfx.control",
    "vfx.event",
    "vfx.template",
    "vfx.particle-create",
    "vfx.particle-info",
    "vfx.particle-main",
    "vfx.particle-emission",
    "vfx.particle-shape",
    "vfx.particle-play",
    "vfx.particle-module",
    "vfx.line-create",
    "vfx.line-positions",
    "vfx.trail"
  ],
  "toolPackageRequirements": {
    "vfx.graph": ["com.unity.visualeffectgraph"],
    "vfx.effect": ["com.unity.visualeffectgraph"],
    "vfx.parameter": ["com.unity.visualeffectgraph"],
    "vfx.control": ["com.unity.visualeffectgraph"],
    "vfx.event": ["com.unity.visualeffectgraph"],
    "vfx.template": ["com.unity.visualeffectgraph"]
  },
  "copyRoot": "extension-directory",
  "installMode": "copy",
  "toolGroups": [
    "vfx"
  ],
  "descriptorEntry": "tools/metadata/vfx.js",
  "bridgeEntry": "bridge/domains/vfx.js",
  "unityPackageFiles": [
    "extension.json",
    "unitypkg/",
    "docs/"
  ],
  "docsTopic": "vfx",
  "docsEntry": "docs/vfx.md",
  "unityInstall": {
    "layout": "directory",
    "include": [
      "extension.json",
      "unitypkg/",
      "docs/"
    ]
  }
}
