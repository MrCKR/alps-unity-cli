{
  "id": "probuilder",
  "name": "ProBuilder",
  "version": "1.0.0",
  "description": "ProBuilder 3D modeling tools: shape creation, mesh editing, face/edge/vertex operations, smoothing, pivots, repair, and boolean CSG through the ProBuilder package.",
  "unityPackages": [
    {
      "packageId": "com.unity.probuilder",
      "displayName": "ProBuilder"
    }
  ],
  "contributions": {
    "tools": [
      {
        "name": "probuilder.ping"
      },
      {
        "name": "probuilder.create-shape"
      },
      {
        "name": "probuilder.create-poly-shape"
      },
      {
        "name": "probuilder.extrude-faces"
      },
      {
        "name": "probuilder.delete-faces"
      },
      {
        "name": "probuilder.detach-faces"
      },
      {
        "name": "probuilder.merge-faces"
      },
      {
        "name": "probuilder.subdivide"
      },
      {
        "name": "probuilder.flip-normals"
      },
      {
        "name": "probuilder.select-faces"
      },
      {
        "name": "probuilder.set-face-material"
      },
      {
        "name": "probuilder.set-face-color"
      },
      {
        "name": "probuilder.set-face-uvs"
      },
      {
        "name": "probuilder.extrude-edges"
      },
      {
        "name": "probuilder.bevel-edges"
      },
      {
        "name": "probuilder.bridge-edges"
      },
      {
        "name": "probuilder.connect-elements"
      },
      {
        "name": "probuilder.combine-meshes"
      },
      {
        "name": "probuilder.merge-objects"
      },
      {
        "name": "probuilder.duplicate-and-flip"
      },
      {
        "name": "probuilder.create-polygon"
      },
      {
        "name": "probuilder.merge-vertices"
      },
      {
        "name": "probuilder.weld-vertices"
      },
      {
        "name": "probuilder.split-vertices"
      },
      {
        "name": "probuilder.move-vertices"
      },
      {
        "name": "probuilder.insert-vertex"
      },
      {
        "name": "probuilder.append-vertices-to-edge"
      },
      {
        "name": "probuilder.mesh-info"
      },
      {
        "name": "probuilder.validate-mesh"
      },
      {
        "name": "probuilder.convert-to-probuilder"
      },
      {
        "name": "probuilder.set-smoothing"
      },
      {
        "name": "probuilder.auto-smooth"
      },
      {
        "name": "probuilder.center-pivot"
      },
      {
        "name": "probuilder.freeze-transform"
      },
      {
        "name": "probuilder.set-pivot"
      },
      {
        "name": "probuilder.repair-mesh"
      }
    ],
    "contexts": [
      {
        "key": "probuilder.scene",
        "description": "Read ProBuilder mesh objects, face/edge/vertex selection context, and editable mesh state in the current scene.",
        "category": "probuilder",
        "inputSchema": {
          "type": "object",
          "properties": {
            "namePattern": {
              "type": "string",
              "description": "Optional case-insensitive substring filter for ProBuilder GameObject names or hierarchy paths."
            },
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Maximum number of ProBuilder mesh objects to return in this read."
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "installed": { "type": "boolean" },
            "sceneCount": { "type": "integer" },
            "objectCount": { "type": "integer" },
            "selectedObjectCount": { "type": "integer" },
            "pageSize": { "type": "integer" },
            "truncated": { "type": "boolean" },
            "objects": { "type": "array", "items": { "type": "object" } },
            "selection": { "type": "object" }
          }
        },
        "target": "editor",
        "availabilityScope": "editorSession",
        "playModeSupport": "supported",
        "refreshBehavior": "onDemand"
      }
    ],
    "csharpEntries": [
      {
        "type": "UnityCli.ProBuilder.ProBuilderUtilityTools",
        "description": "Bridge handlers for ProBuilder ping, mesh-info, and validate-mesh."
      },
      {
        "type": "UnityCli.ProBuilder.ProBuilderShapeTools",
        "description": "Bridge handlers for ProBuilder create-shape and create-poly-shape."
      },
      {
        "type": "UnityCli.ProBuilder.ProBuilderMeshEditTools",
        "description": "Bridge handlers for ProBuilder face, edge, and mesh editing operations."
      },
      {
        "type": "UnityCli.ProBuilder.ProBuilderVertexTools",
        "description": "Bridge handlers for ProBuilder vertex operations."
      },
      {
        "type": "UnityCli.ProBuilder.ProBuilderSelectionTools",
        "description": "Bridge handlers for ProBuilder selection and material/color/UV operations."
      },
      {
        "type": "UnityCli.ProBuilder.ProBuilderSmoothingTools",
        "description": "Bridge handlers for ProBuilder smoothing, pivot, transform, and repair operations."
      },
      {
        "type": "UnityCli.ProBuilder.ProBuilderSceneContext",
        "description": "Read-only context for ProBuilder scene mesh objects, counts, and selection state."
      }
    ]
  },
  "unityInstall": {
    "layout": "directory",
    "include": [
      "extension.json",
      "unitypkg/",
      "docs/"
    ]
  }
}
