{
  "id": "urp",
  "name": "Universal Render Pipeline",
  "version": "1.0.0",
  "description": "URP rendering tools for renderer features, volume components, and Universal Render Pipeline asset settings.",
  "unityPackages": [
    { "packageId": "com.unity.render-pipelines.universal", "displayName": "Universal Render Pipeline" }
  ],
  "contributions": {
    "tools": [
      { "name": "urp.feature.list" },
      { "name": "urp.feature.add" },
      { "name": "urp.feature.toggle" },
      { "name": "urp.feature.configure" },
      { "name": "urp.feature.remove" },
      { "name": "urp.volume.list" },
      { "name": "urp.volume.create" },
      { "name": "urp.volume.info" },
      { "name": "urp.volume.add-effect" },
      { "name": "urp.volume.set" },
      { "name": "urp.settings.get" },
      { "name": "urp.settings.set" }
    ],
    "contexts": [],
    "csharpEntries": [
      { "type": "UnityCli.UrpFeatureListTool", "description": "Implements urp.feature.list." },
      { "type": "UnityCli.UrpFeatureAddTool", "description": "Implements urp.feature.add." },
      { "type": "UnityCli.UrpFeatureToggleTool", "description": "Implements urp.feature.toggle." },
      { "type": "UnityCli.UrpFeatureConfigureTool", "description": "Implements urp.feature.configure." },
      { "type": "UnityCli.UrpFeatureRemoveTool", "description": "Implements urp.feature.remove." },
      { "type": "UnityCli.UrpVolumeListTool", "description": "Implements urp.volume.list." },
      { "type": "UnityCli.UrpVolumeInfoTool", "description": "Implements urp.volume.info." },
      { "type": "UnityCli.UrpVolumeCreateTool", "description": "Implements urp.volume.create." },
      { "type": "UnityCli.UrpVolumeAddEffectTool", "description": "Implements urp.volume.add-effect." },
      { "type": "UnityCli.UrpVolumeSetTool", "description": "Implements urp.volume.set." },
      { "type": "UnityCli.UrpSettingsGetTool", "description": "Implements urp.settings.get." },
      { "type": "UnityCli.UrpSettingsSetTool", "description": "Implements urp.settings.set." }
    ]
  },
  "unityInstall": { "layout": "directory", "include": ["extension.json", "unitypkg/", "docs/"] },
  "tags": ["rendering", "pipeline", "urp"]
}
