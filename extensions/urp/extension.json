{
  "id": "urp",
  "name": "Universal Render Pipeline",
  "version": "1.0.0",
  "description": "URP rendering tools: renderer features, volume components, and Universal Render Pipeline asset settings.",
  "unityPackages": [
    {
      "packageId": "com.unity.render-pipelines.universal",
      "displayName": "Universal Render Pipeline"
    }
  ],
  "contributions": {
    "tools": [
      {
        "name": "urp.feature"
      },
      {
        "name": "urp.volume"
      },
      {
        "name": "urp.settings"
      }
    ],
    "contexts": [],
    "csharpEntries": [
      {
        "type": "UnityCli.UrpFeatureTool",
        "description": "Self-contained URP renderer feature tool."
      },
      {
        "type": "UnityCli.UrpVolumeTool",
        "description": "Self-contained URP volume tool."
      },
      {
        "type": "UnityCli.UrpSettingsTool",
        "description": "Self-contained URP pipeline settings tool."
      }
    ]
  },
  "unityInstall": {
    "layout": "directory",
    "include": [
      "extension.json",
      "unitypkg/",
      "docs/"
    ]
  }
}
