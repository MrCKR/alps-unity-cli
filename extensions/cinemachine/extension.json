{
  "id": "cinemachine",
  "name": "Cinemachine",
  "version": "1.0.0",
  "description": "Cinemachine camera tools: virtual camera creation, targets, lens, priority, blends, body/aim/noise, brain overrides, and extensions.",
  "unityPackages": [
    {
      "packageId": "com.unity.cinemachine",
      "displayName": "Cinemachine"
    }
  ],
  "contributions": {
    "tools": [
      {
        "name": "cinemachine.ping"
      },
      {
        "name": "cinemachine.create"
      },
      {
        "name": "cinemachine.target"
      },
      {
        "name": "cinemachine.lens"
      },
      {
        "name": "cinemachine.priority"
      },
      {
        "name": "cinemachine.blend"
      },
      {
        "name": "cinemachine.body"
      },
      {
        "name": "cinemachine.aim"
      },
      {
        "name": "cinemachine.noise"
      },
      {
        "name": "cinemachine.brain"
      },
      {
        "name": "cinemachine.force-camera"
      },
      {
        "name": "cinemachine.release-override"
      },
      {
        "name": "cinemachine.extension"
      }
    ],
    "contexts": [],
    "csharpEntries": [
      {
        "type": "UnityCli.Cinemachine.PingTool",
        "description": "Self-contained Cinemachine ping tool."
      },
      {
        "type": "UnityCli.Cinemachine.CreateTool",
        "description": "Self-contained Cinemachine create tool."
      },
      {
        "type": "UnityCli.Cinemachine.TargetTool",
        "description": "Self-contained Cinemachine target tool."
      },
      {
        "type": "UnityCli.Cinemachine.LensTool",
        "description": "Self-contained Cinemachine lens tool."
      },
      {
        "type": "UnityCli.Cinemachine.PriorityTool",
        "description": "Self-contained Cinemachine priority tool."
      },
      {
        "type": "UnityCli.Cinemachine.BlendTool",
        "description": "Self-contained Cinemachine blend tool."
      },
      {
        "type": "UnityCli.Cinemachine.BodyTool",
        "description": "Self-contained Cinemachine body tool."
      },
      {
        "type": "UnityCli.Cinemachine.AimTool",
        "description": "Self-contained Cinemachine aim tool."
      },
      {
        "type": "UnityCli.Cinemachine.NoiseTool",
        "description": "Self-contained Cinemachine noise tool."
      },
      {
        "type": "UnityCli.Cinemachine.BrainTool",
        "description": "Self-contained Cinemachine brain tool."
      },
      {
        "type": "UnityCli.Cinemachine.ForceCameraTool",
        "description": "Self-contained Cinemachine force-camera tool."
      },
      {
        "type": "UnityCli.Cinemachine.ReleaseOverrideTool",
        "description": "Self-contained Cinemachine release-override tool."
      },
      {
        "type": "UnityCli.Cinemachine.ExtensionTool",
        "description": "Self-contained Cinemachine extension tool."
      }
    ]
  },
  "unityInstall": {
    "layout": "directory",
    "include": [
      "extension.json",
      "unitypkg/",
      "docs/"
    ]
  }
}
