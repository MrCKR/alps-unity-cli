{
  "name": "@alps_ckr/unity_cli",
  "version": "0.1.0",
  "description": "Windows-first CLI for Unity CLI automation.",
  "type": "module",
  "bin": {
    "unity_cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "cli",
    "unitypkg",
    "contracts",
    "schemas",
    "skills",
    "docs",
    "tests",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"dist/**/*.test.js\"",
    "pretest": "npm run build",
    "contracts:validate": "npm run build && node dist/contracts/validate-command-contract.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3"
  },
  "license": "MIT"
}
