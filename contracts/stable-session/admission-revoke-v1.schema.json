{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitycli.local/contracts/stable-session/admission-revoke-v1.schema.json",
  "title": "UnityCLI internal unconsumed admission revoke v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "instanceId", "target", "rootFingerprint"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "instanceId": { "type": "string", "pattern": "^unity-[0-9a-f]{64}$" },
    "target": { "enum": ["editor", "runtime"] },
    "rootFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
