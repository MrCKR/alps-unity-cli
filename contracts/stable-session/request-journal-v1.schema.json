{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unity-cli.local/contracts/stable-session/request-journal-v1.schema.json",
  "title": "Unity CLI durable mutation request journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requestId",
    "instanceId",
    "editorSessionId",
    "command",
    "toolName",
    "digestVersion",
    "requestDigest",
    "executionClass",
    "completionDriverId",
    "absoluteDeadlineUtc",
    "state",
    "phase"
  ],
  "properties": {
    "version": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "instanceId": { "type": "string", "pattern": "^unity-[0-9a-f]{64}$" },
    "editorSessionId": { "type": "string", "pattern": "^session-[0-9a-f]{64}$" },
    "command": { "type": "string", "minLength": 1 },
    "toolName": { "type": "string", "minLength": 1 },
    "digestVersion": { "const": 1 },
    "requestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "executionClass": { "enum": ["atomic", "observed-state", "resumable", "external"] },
    "completionDriverId": { "type": "string", "minLength": 1 },
    "absoluteDeadlineUtc": { "type": "string", "format": "date-time" },
    "state": { "enum": ["created", "accepted", "running", "completed", "failed", "cancelled", "outcome_unknown"] },
    "phase": { "enum": ["received", "accepted_before_effect", "effect_started", "effect_proven", "result_persisted"] },
    "acceptedAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "continuationKind": { "type": "string", "minLength": 1 },
    "continuationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "continuation": { "type": "object" },
    "proofKind": { "type": "string", "minLength": 1 },
    "proofSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provenEnvelope": {
      "type": "object",
      "required": ["ok", "requestId"],
      "properties": {
        "ok": { "type": "boolean" },
        "requestId": { "type": "string" }
      }
    },
    "terminalEnvelope": {
      "type": "object",
      "required": ["ok", "requestId"],
      "properties": {
        "ok": { "type": "boolean" },
        "requestId": { "type": "string" }
      }
    },
    "compileOperation": { "$ref": "#/$defs/compileOperation" }
  },
  "$defs": {
    "compileOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "sequence", "runId", "phase", "lease", "refresh", "path",
        "forceUpdate", "importRecursive", "includeWarnings", "assemblies", "diagnostics",
        "stableFrames", "stableSequence", "lastBrokerSequence", "triggerEventSequence", "callbackError"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "runId": { "type": "string", "pattern": "^compile-[0-9a-f]{32}$" },
        "phase": { "enum": ["queued", "waiting_preexisting", "preexisting_stable", "trigger_committed", "dispatching", "awaiting_started", "compiling", "cycle_finished", "waiting_stable", "proven", "terminal"] },
        "lease": { "type": ["string", "null"], "pattern": "^session-[0-9a-f]{64}$" },
        "refresh": { "type": "boolean" },
        "path": { "type": ["string", "null"] },
        "forceUpdate": { "type": "boolean" },
        "importRecursive": { "type": "boolean" },
        "includeWarnings": { "type": "boolean" },
        "assemblies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/compileDiagnostic" } },
        "stableFrames": { "type": "integer", "minimum": 0 },
        "stableSequence": { "type": "integer", "minimum": -1 },
        "stableSince": { "type": ["string", "null"], "format": "date-time" },
        "lastBrokerSequence": { "type": "integer", "minimum": 0 },
        "triggerEventSequence": { "type": "integer", "minimum": 0 },
        "startedCycle": { "type": "integer", "minimum": 1 },
        "startedSequence": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedCycle": { "type": "integer", "minimum": 1 },
        "finishedSequence": { "type": "integer", "minimum": 1 },
        "finishedAt": { "type": "string", "format": "date-time" },
        "reloadObserved": { "type": "boolean" },
        "callbackError": { "type": ["string", "null"], "minLength": 1 }
      },
      "dependentRequired": {
        "startedCycle": ["startedSequence", "startedAt"],
        "startedSequence": ["startedCycle", "startedAt"],
        "startedAt": ["startedCycle", "startedSequence"],
        "finishedCycle": ["finishedSequence", "finishedAt", "startedCycle", "startedSequence", "startedAt"],
        "finishedSequence": ["finishedCycle", "finishedAt", "startedCycle", "startedSequence", "startedAt"],
        "finishedAt": ["finishedCycle", "finishedSequence", "startedCycle", "startedSequence", "startedAt"]
      }
    },
    "compileDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assembly", "severity", "code", "message", "file", "line", "column"],
      "properties": {
        "assembly": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning", "info"] },
        "code": { "type": ["string", "null"] },
        "message": { "type": "string", "minLength": 1 },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
