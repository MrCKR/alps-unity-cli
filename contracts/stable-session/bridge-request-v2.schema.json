{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unity-cli.local/contracts/stable-session/bridge-request-v2.schema.json",
  "title": "Unity CLI immutable Bridge request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "instanceId", "command", "input", "execution"],
  "properties": {
    "protocolVersion": { "const": 2 },
    "requestId": { "type": "string", "pattern": "^req_[0-9a-f-]+$" },
    "instanceId": { "type": "string", "pattern": "^unity-[0-9a-f]{64}$" },
    "command": { "type": "string", "minLength": 1 },
    "input": { "type": "object" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absoluteDeadlineUtc", "completionContractVersion", "requestDigestVersion"],
      "properties": {
        "absoluteDeadlineUtc": { "type": "string", "format": "date-time" },
        "completionContractVersion": { "const": 1 },
        "requestDigestVersion": { "const": 1 },
        "dryRun": { "type": "boolean" },
        "securityProof": { "type": ["object", "null"] }
      }
    }
  }
}
