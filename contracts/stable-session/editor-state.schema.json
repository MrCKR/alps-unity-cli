{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitycli.local/contracts/stable-session/editor-state.schema.json",
  "title": "editor.state public observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "session", "status", "state", "progress", "blockers", "observation"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "canonicalProjectPath", "displayProjectPath"],
      "properties": {
        "instanceId": { "type": "string" },
        "canonicalProjectPath": { "type": "string" },
        "displayProjectPath": { "type": "string" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known", "editorSessionId"],
      "properties": {
        "known": { "type": "boolean" },
        "editorSessionId": { "type": ["string", "null"] }
      }
    },
    "status": { "enum": ["ready", "transitioning", "blocked", "unresponsive", "unverifiable", "offline", "conflict"] },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile", "import", "build", "playMode", "prefabStage", "activeScene", "runtime"],
      "properties": {
        "compile": { "$ref": "#/$defs/observedField" },
        "import": { "$ref": "#/$defs/observedField" },
        "build": { "$ref": "#/$defs/observedField" },
        "playMode": { "$ref": "#/$defs/observedField" },
        "prefabStage": { "$ref": "#/$defs/observedField" },
        "activeScene": { "$ref": "#/$defs/observedField" },
        "runtime": { "$ref": "#/$defs/observedField" }
      }
    },
    "progress": { "type": "array", "items": { "$ref": "#/$defs/progress" } },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshness", "reason"],
      "properties": {
        "freshness": { "enum": ["live", "fresh", "stale", "unknown"] },
        "reason": {
          "description": "Why Unity process identity could not be proven; null when this read proved it.",
          "enum": ["access-denied", "timeout", "unavailable", "mismatch", null]
        }
      }
    }
  },
  "$defs": {
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "canWait", "source"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "canWait": { "type": "boolean" },
        "source": { "enum": ["unity", "registry"] }
      }
    },
    "blocker": {
      "description": "Public blocker DTO. Two exact variants exist: an independently observed Windows modal (source windows-ui) and a deliberate main-thread debug pause proven by the current live pause publication (source unity-debug-pause).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "dialogId", "title", "message", "buttons", "requiresUserAction", "source", "confidence"],
          "properties": {
            "type": { "const": "dialog" },
            "dialogId": { "type": "string", "minLength": 1 },
            "title": { "type": "string" },
            "message": { "type": "string" },
            "buttons": { "type": "array", "items": { "type": "string" } },
            "requiresUserAction": { "const": true },
            "source": { "const": "windows-ui" },
            "confidence": { "const": "exact" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "pauseId", "threadId", "mainThread", "methodIdentity", "targetKey", "position", "sessionId", "timeoutKind", "remainingMs", "pausedForMs", "resumeTool", "infoTool", "requiresUserAction", "source", "confidence"],
          "properties": {
            "type": { "const": "debug-pause" },
            "pauseId": { "type": "string", "minLength": 1 },
            "threadId": { "type": "integer", "minimum": 1 },
            "mainThread": { "type": "boolean" },
            "methodIdentity": { "type": "string" },
            "targetKey": { "type": "string" },
            "position": { "enum": ["prefix", "postfix"] },
            "sessionId": { "type": "string" },
            "timeoutKind": { "enum": ["bounded", "unbounded"] },
            "remainingMs": { "type": "number", "minimum": 0 },
            "pausedForMs": { "type": "number", "minimum": 0 },
            "resumeTool": { "const": "debug.pause.resume" },
            "infoTool": { "const": "debug.pause.list" },
            "requiresUserAction": { "const": false },
            "source": { "const": "unity-debug-pause" },
            "confidence": { "const": "exact" }
          }
        }
      ]
    },
    "observedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known"],
      "properties": {
        "known": { "type": "boolean" },
        "value": { "x-unityCliAnyJson": true }
      }
    }
  }
}
