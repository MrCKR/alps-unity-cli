{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unity-cli.local/contracts/stable-session/admission-acquire-v1.schema.json",
  "title": "Unity CLI internal task admission acquire v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "instanceId", "target", "command", "rootFingerprint"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "instanceId": { "type": "string", "pattern": "^unity-[0-9a-f]{64}$" },
    "target": { "enum": ["editor", "runtime"] },
    "command": { "type": "string", "minLength": 1, "maxLength": 256 },
    "rootFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
