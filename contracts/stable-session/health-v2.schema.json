{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unity-cli.local/contracts/stable-session/health-v2.schema.json",
  "title": "Unity CLI Bridge health identity v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "instanceId", "canonicalProjectPath", "canonicalizationVersion", "editorSessionId", "listenerId", "actualPort", "buildStamp"],
  "properties": {
    "version": { "const": 2 },
    "instanceId": { "type": "string", "pattern": "^unity-[0-9a-f]{64}$" },
    "canonicalProjectPath": { "type": "string", "minLength": 3 },
    "canonicalizationVersion": { "const": 1 },
    "editorSessionId": { "type": "string", "pattern": "^session-[0-9a-f]{64}$" },
    "listenerId": { "type": "string", "pattern": "^listener-[0-9a-f-]+$" },
    "actualPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "buildStamp": { "type": "string", "minLength": 1 }
  }
}
