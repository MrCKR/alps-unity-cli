{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitycli.local/schemas/response-envelope.schema.json",
  "title": "UnityCLI Response Envelope",
  "description": "Unified response envelope for CLI commands. Field names are camelCase; successful command payloads live under data, structured failures live under error.",
  "oneOf": [
    {
      "title": "Success Response",
      "type": "object",
      "required": ["ok", "requestId", "data"],
      "properties": {
        "ok": { "const": true, "description": "The command succeeded." },
        "requestId": { "type": "string", "description": "Echoes the request requestId." },
        "data": {
          "type": "object",
          "description": "Command-specific result payload. For C# tools this is serialized from the Result DTO."
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Non-fatal warnings encountered during execution."
        }
      },
      "additionalProperties": false
    },
    {
      "title": "Error Response",
      "type": "object",
      "required": ["ok", "requestId", "error"],
      "properties": {
        "ok": { "const": false, "description": "The command failed." },
        "requestId": { "type": "string", "description": "Echoes the request requestId." },
        "error": {
          "$ref": "./error-code.schema.json",
          "description": "Structured error details. Recovery guidance is nested under error.nextActions and transient retry delay under error.retryAfterMs."
        }
      },
      "additionalProperties": false
    }
  ]
}
