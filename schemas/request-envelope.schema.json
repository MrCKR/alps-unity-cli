{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unity-cli.local/schemas/request-envelope.schema.json",
  "title": "Unity CLI Bridge Request v2",
  "description": "Exact immutable request envelope sent by the CLI session supervisor to one verified Live Editor instance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "instanceId", "command", "requestId", "input", "execution"],
  "properties": {
    "protocolVersion": { "const": 2 },
    "instanceId": { "type": "string", "pattern": "^unity-[0-9a-f]{64}$" },
    "command": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "input": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/anyJson" }
    },
    "execution": { "$ref": "#/$defs/execution" }
  },
  "$defs": {
    "anyJson": { "x-unityCliAnyJson": true },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absoluteDeadlineUtc", "completionContractVersion", "requestDigestVersion"],
      "properties": {
        "absoluteDeadlineUtc": { "type": "string", "format": "date-time" },
        "completionContractVersion": { "const": 1 },
        "requestDigestVersion": { "const": 1 },
        "dryRun": { "type": "boolean" }
      }
    }
  }
}
