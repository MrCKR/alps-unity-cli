{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unity-cli.local/schemas/extension-manifest.schema.json",
  "title": "Unity CLI Extension Manifest",
  "description": "Describes a CLI extension package: identity, Unity package prerequisites, contribution IDs, C# entries, and Unity-side install projection. Detailed AI-facing tool metadata lives in extension tool metadata files.",
  "type": "object",
  "required": ["id", "name", "description", "version", "unityPackages", "contributions"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Unique extension identifier in kebab-case, e.g. 'probuilder', 'vfx-graph'."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable extension name, e.g. 'ProBuilder'."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One-paragraph explanation of the extension."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Extension version, usually semver."
    },
    "unityPackages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["packageId", "displayName"],
        "properties": {
          "packageId": {
            "type": "string",
            "minLength": 1,
            "description": "Unity package identifier, e.g. 'com.unity.probuilder'."
          },
          "versionRange": {
            "type": "string",
            "description": "Optional version range constraint."
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable package name, e.g. 'ProBuilder'."
          }
        },
        "additionalProperties": false
      },
      "description": "Required Unity packages for this extension to be available."
    },
    "contributions": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Tool name contributed by the extension. Full descriptor lives in extension TS metadata."
              },
              "requiresPackages": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Unity packages required by this specific tool. Omitted means use extension-level package prerequisites."
              }
            },
            "additionalProperties": false
          },
          "description": "Tool capability IDs contributed by this extension."
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "description"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "category": { "type": "string" },
              "inputSchema": { "type": "object" },
              "outputSchema": { "type": "object" },
              "target": { "type": "string", "enum": ["editor", "runtime", "both"] },
              "availabilityScope": { "type": "string", "enum": ["editorSession", "playModeSession", "always"] },
              "playModeSupport": { "type": "string", "enum": ["supported", "runtime-only", "session-affecting", "editor-only", "unknown"] },
              "refreshBehavior": { "type": "string" }
            },
            "additionalProperties": false
          },
          "description": "Context descriptors contributed by this extension."
        },
        "csharpEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "description"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "method": { "type": "string" },
              "description": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "description": "C# implementation entries included in the extension bundle."
        }
      },
      "additionalProperties": false,
      "description": "Capabilities contributed by this extension."
    },
    "unityInstall": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "const": "directory",
          "description": "Install this extension as a subdirectory under Packages/com.unity_cli/Extensions/<id>."
        },
        "include": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Source paths relative to extensions/<id>/ projected into the Unity extension directory."
        }
      },
      "additionalProperties": false,
      "description": "Unity-side directory install projection."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tags for categorization."
    },
    "homepage": {
      "type": "string",
      "description": "Homepage or documentation URL."
    }
  },
  "additionalProperties": false
}
