{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unity-cli.local/schemas/tool-metadata.schema.json",
  "title": "Unity CLI Public Tool Descriptor",
  "description": "Public direct Tool descriptor used for discovery and first-call routing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "summary",
    "description",
    "group",
    "inputSchema",
    "outputSchema",
    "destructiveHint",
    "supportsDryRun",
    "target",
    "availabilityScope",
    "playModeSupport",
    "available"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "group": { "type": "string", "minLength": 1 },
    "inputSchema": { "type": "object" },
    "outputSchema": { "type": "object" },
    "destructiveHint": { "type": "boolean" },
    "sideEffects": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "playModeSupport": {
      "type": "string",
      "enum": ["supported", "runtime-only", "session-affecting", "editor-only", "unknown"]
    },
    "supportsDryRun": { "type": "boolean" },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "argv"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "source": {
      "type": "string",
      "enum": ["built-in", "project", "extension"]
    },
    "target": {
      "type": "string",
      "enum": ["editor", "runtime", "both"]
    },
    "availabilityScope": {
      "type": "string",
      "enum": ["editorSession", "playModeSession", "always"]
    },
    "available": { "type": "boolean" },
    "unavailableReason": { "type": "string", "minLength": 1 },
    "requiresPackages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "extensionId": { "type": "string", "minLength": 1 }
  }
}
