{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alps.local/schemas/error-code.schema.json",
  "title": "Unity CLI Error",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "message": { "type": "string" },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
