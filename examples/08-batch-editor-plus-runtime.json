{
  "defaults": {
    "project": "C:/work/Game",
    "unity": "C:/Program Files/Unity/Hub/Editor/2022.3.45f1/Editor/Unity.exe",
    "wait": true,
    "timeoutMs": 600000,
    "waitTimeoutMs": 600000,
    "env": {
      "UNITY_CLI_BRIDGE_ENDPOINT": "http://127.0.0.1:18080"
    }
  },
  "envAllowlist": ["UNITY_CLI_BRIDGE_ENDPOINT"],
  "failFast": true,
  "parallel": 1,
  "steps": [
    {
      "id": "read-editor-console",
      "command": ["tools", "run", "editor.console"]
    },
    {
      "id": "list-cameras",
      "command": ["tools", "run", "camera.list"]
    },
    {
      "id": "capture-screenshot",
      "command": ["tools", "run", "camera.screenshot"],
      "args": ["--input", "{\"target\":\"Main Camera\",\"output\":\"Artifacts/pre-runtime-screenshot.png\",\"overwrite\":true}"],
      "dependsOn": ["list-cameras"]
    },
    {
      "id": "enter-play-mode",
      "command": ["tools", "run", "editor.play"],
      "dependsOn": ["read-editor-console", "capture-screenshot"]
    },
    {
      "id": "run-runtime-echo",
      "command": ["tools", "run", "sample.echo"],
      "args": ["--input", "{\"message\":\"editor+runtime combined\"}", "--include-custom"],
      "dependsOn": ["enter-play-mode"]
    },
    {
      "id": "run-runtime-wait",
      "command": ["tools", "run", "sample.wait"],
      "args": ["--input", "{\"durationMs\":300,\"message\":\"runtime step done\"}", "--include-custom", "--timeout-ms", "5000"],
      "dependsOn": ["run-runtime-echo"]
    },
    {
      "id": "exit-play-mode",
      "command": ["tools", "run", "editor.stop"],
      "dependsOn": ["run-runtime-wait"]
    },
    {
      "id": "verify-after-runtime",
      "command": ["tools", "run", "editor.console"],
      "dependsOn": ["exit-play-mode"]
    }
  ]
}
