{
  "$schema": "../contracts/batch-schema.json",
  "description": "Error recovery batch example — covers 3 runtime error recovery scenarios:\n1. E_RUNTIME_NOT_READY → enter Play Mode → retry\n2. E_RUNTIME_SESSION_STALE → refresh sessionId → retry\n3. E_RUNTIME_TIMEOUT → increase timeoutMs → retry\nEach scenario uses failFast=false so independent steps can continue.",
  "defaults": {
    "project": ".",
    "unity": "/path/to/Unity"
  },
  "failFast": false,
  "steps": [
    {
      "id": "attempt-runtime-not-ready",
      "command": ["tools", "run"],
      "args": ["sample.runtime-echo", "--message", "not-ready-test"],
      "timeoutMs": 5000
    },
    {
      "id": "enter-play-mode-on-not-ready",
      "command": ["editor", "play"],
      "dependsOn": ["attempt-runtime-not-ready"]
    },
    {
      "id": "retry-runtime-after-play",
      "command": ["tools", "run"],
      "args": ["sample.runtime-echo", "--message", "retry-after-playmode"],
      "playModeSessionId": "session_recovery_001",
      "dependsOn": ["enter-play-mode-on-not-ready"]
    },
    {
      "id": "exit-play-after-not-ready-recovery",
      "command": ["editor", "stop"],
      "dependsOn": ["retry-runtime-after-play"]
    },
    {
      "id": "attempt-stale-session",
      "command": ["tools", "run"],
      "args": ["sample.runtime-echo", "--message", "stale-session-test"],
      "playModeSessionId": "stale_session_old"
    },
    {
      "id": "refresh-session-and-retry",
      "command": ["tools", "run"],
      "args": ["sample.runtime-echo", "--message", "retry-after-session-refresh"],
      "playModeSessionId": "session_recovery_002",
      "dependsOn": ["attempt-stale-session"]
    },
    {
      "id": "exit-play-after-stale-recovery",
      "command": ["editor", "stop"],
      "dependsOn": ["refresh-session-and-retry"]
    },
    {
      "id": "attempt-runtime-timeout",
      "command": ["tools", "run"],
      "args": ["runtime.wait", "--duration", "10000"],
      "timeoutMs": 3000,
      "playModeSessionId": "session_recovery_003"
    },
    {
      "id": "increase-timeout-and-retry",
      "command": ["tools", "run"],
      "args": ["runtime.wait", "--duration", "10000"],
      "timeoutMs": 15000,
      "playModeSessionId": "session_recovery_003",
      "dependsOn": ["attempt-runtime-timeout"]
    },
    {
      "id": "exit-play-after-timeout-recovery",
      "command": ["editor", "stop"],
      "dependsOn": ["increase-timeout-and-retry"]
    }
  ]
}
